# Copy to `.env` (git-ignored) and replace every CHANGE_ME. Never commit the real file.
# On a real server, prefer injecting these from your secret manager (see docs/operations/secrets.md).

# Registry path WITHOUT tag, e.g. ghcr.io/<owner>/nexora-platform
NEXORA_IMAGE_REGISTRY=ghcr.io/tuannt2906/nexora-platform
# Immutable release tag = full git SHA published by the release workflow. Never `latest`.
NEXORA_IMAGE_TAG=CHANGE_ME_RELEASE_SHA

NEXORA_ENVIRONMENT=production
NEXORA_LOG_LEVEL=INFO
NEXORA_WEB_PORT=8080
NEXORA_CORS_ORIGINS=

# SECRETS -- the Postgres password is embedded in a URL: use only [A-Za-z0-9_-] characters
# (generate with: openssl rand -hex 24).
NEXORA_POSTGRES_PASSWORD=CHANGE_ME
NEXORA_API_TOKEN=CHANGE_ME
