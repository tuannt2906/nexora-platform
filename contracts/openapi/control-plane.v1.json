{
  "components": {
    "schemas": {
      "AcceptanceCriterion": {
        "properties": {
          "criterion": {
            "title": "Criterion",
            "type": "string"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Repo-relative path of the test proving a MET criterion",
            "title": "Evidence"
          },
          "id": {
            "pattern": "^[A-Z]{2,5}-\\d{1,3}$",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CriterionStatus"
          }
        },
        "required": [
          "id",
          "criterion",
          "status"
        ],
        "title": "AcceptanceCriterion",
        "type": "object"
      },
      "AdapterInfo": {
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "contract_doc": {
            "title": "Contract Doc",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/EngineKind"
          },
          "maturity": {
            "title": "Maturity",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "display_name",
          "maturity",
          "capabilities",
          "contract_doc"
        ],
        "title": "AdapterInfo",
        "type": "object"
      },
      "AuditEventOut": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "actor": {
            "title": "Actor",
            "type": "string"
          },
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "occurred_at",
          "actor",
          "action",
          "target",
          "detail"
        ],
        "title": "AuditEventOut",
        "type": "object"
      },
      "ConfigKey": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "key": {
            "pattern": "^NEXORA_[A-Z0-9_]+$",
            "title": "Key",
            "type": "string"
          },
          "secret": {
            "default": false,
            "title": "Secret",
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "ConfigKey",
        "type": "object"
      },
      "ConnectionCreate": {
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Endpoint",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/EngineKind"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "title": "Name",
            "type": "string"
          },
          "options": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 32,
            "title": "Options",
            "type": "object"
          },
          "secret_ref": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque reference to a secret in the external secret manager. Never a secret.",
            "title": "Secret Ref"
          }
        },
        "required": [
          "kind",
          "name",
          "endpoint"
        ],
        "title": "ConnectionCreate",
        "type": "object"
      },
      "ConnectionHealth": {
        "properties": {
          "health": {
            "$ref": "#/components/schemas/HealthReport"
          },
          "kind": {
            "$ref": "#/components/schemas/EngineKind"
          },
          "maturity": {
            "title": "Maturity",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "maturity",
          "health"
        ],
        "title": "ConnectionHealth",
        "type": "object"
      },
      "ConnectionOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "endpoint": {
            "title": "Endpoint",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/EngineKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "options": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Options",
            "type": "object"
          },
          "secret_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secret Ref"
          }
        },
        "required": [
          "name",
          "kind",
          "endpoint",
          "secret_ref",
          "options",
          "created_at"
        ],
        "title": "ConnectionOut",
        "type": "object"
      },
      "CriterionStatus": {
        "enum": [
          "met",
          "unmet",
          "planned"
        ],
        "title": "CriterionStatus",
        "type": "string"
      },
      "EngineKind": {
        "description": "Stable identifiers of supported engine types. Adding a value is an ADR-worthy change.",
        "enum": [
          "kafka",
          "kafka-connect",
          "flink",
          "spark",
          "iceberg-rest-catalog",
          "object-store-s3",
          "trino",
          "airflow",
          "openlineage",
          "prometheus"
        ],
        "title": "EngineKind",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthReport": {
        "description": "Result of probing one engine endpoint. Never contains secrets.",
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "latency_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "state": {
            "$ref": "#/components/schemas/HealthState"
          }
        },
        "required": [
          "state"
        ],
        "title": "HealthReport",
        "type": "object"
      },
      "HealthState": {
        "enum": [
          "healthy",
          "degraded",
          "unhealthy",
          "unknown"
        ],
        "title": "HealthState",
        "type": "string"
      },
      "Maturity": {
        "description": "How much of an integration is actually verified. Ordered from weakest to strongest.",
        "enum": [
          "planned",
          "contract",
          "probe",
          "functional",
          "production"
        ],
        "title": "Maturity",
        "type": "string"
      },
      "ModuleSpec": {
        "properties": {
          "acceptance": {
            "items": {
              "$ref": "#/components/schemas/AcceptanceCriterion"
            },
            "minItems": 1,
            "title": "Acceptance",
            "type": "array"
          },
          "config": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ConfigKey"
            },
            "title": "Config",
            "type": "array"
          },
          "depends_on": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Depends On",
            "type": "array"
          },
          "engines": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/EngineKind"
            },
            "title": "Engines",
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "maturity": {
            "$ref": "#/components/schemas/Maturity"
          },
          "public_interfaces": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Public Interfaces",
            "type": "array"
          },
          "responsibilities": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Responsibilities",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "maturity",
          "summary",
          "responsibilities",
          "public_interfaces",
          "acceptance"
        ],
        "title": "ModuleSpec",
        "type": "object"
      },
      "PlatformInfo": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "git_sha": {
            "title": "Git Sha",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "environment",
          "git_sha"
        ],
        "title": "PlatformInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "NEXORA Control Plane API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/adapters": {
      "get": {
        "description": "Engine adapters shipped in this release and their honest maturity level.",
        "operationId": "list_adapters_api_v1_adapters_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdapterInfo"
                  },
                  "title": "Response List Adapters Api V1 Adapters Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Adapters",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/audit-events": {
      "get": {
        "operationId": "audit_events_api_v1_audit_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AuditEventOut"
                  },
                  "title": "Response Audit Events Api V1 Audit Events Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Audit Events",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/connections": {
      "get": {
        "operationId": "list_connections_api_v1_connections_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConnectionOut"
                  },
                  "title": "Response List Connections Api V1 Connections Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Connections",
        "tags": [
          "connections"
        ]
      },
      "post": {
        "operationId": "create_connection_api_v1_connections_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Connection",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/connections/{name}": {
      "delete": {
        "operationId": "delete_connection_api_v1_connections__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Connection",
        "tags": [
          "connections"
        ]
      },
      "get": {
        "operationId": "get_connection_api_v1_connections__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Connection",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/connections/{name}/health": {
      "get": {
        "operationId": "connection_health_api_v1_connections__name__health_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionHealth"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Connection Health",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/health/connections": {
      "get": {
        "operationId": "all_connection_health_api_v1_health_connections_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConnectionHealth"
                  },
                  "title": "Response All Connection Health Api V1 Health Connections Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "All Connection Health",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/modules": {
      "get": {
        "description": "Domain modules with responsibilities, interfaces and acceptance status (module.toml).",
        "operationId": "list_modules_api_v1_modules_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModuleSpec"
                  },
                  "title": "Response List Modules Api V1 Modules Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Modules",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/platform": {
      "get": {
        "operationId": "platform_info_api_v1_platform_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Platform Info",
        "tags": [
          "catalog"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is up (no dependencies checked)",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness: dependencies required to serve traffic are reachable",
        "tags": [
          "health"
        ]
      }
    }
  }
}
