# Normalise line endings: the developer workstation is Windows, production is Linux.
* text=auto eol=lf

# Files that MUST be LF or they break on Linux servers / containers.
*.sh        text eol=lf
Makefile    text eol=lf
*.mk        text eol=lf
Dockerfile* text eol=lf
*.Dockerfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.toml      text eol=lf
*.tpl       text eol=lf

# Windows-only scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
